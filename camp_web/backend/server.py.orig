    "caries": os.getenv("CARIES_API_URL", os.getenv("MODEL_OCCLUSAL", "" if IS_PRODUCTION else "http://127.0.0.1:8001/analyze")),
    "tooth": os.getenv("TOOTH_API_URL", os.getenv("MODEL_TOOTH", "" if IS_PRODUCTION else "http://127.0.0.1:8002/analyze")),
    "gingivitis": os.getenv("GINGIVITIS_API_URL", os.getenv("MODEL_GINGIVITIS", "" if IS_PRODUCTION else "http://127.0.0.1:8003/analyze")),
}
MODEL_KEYS = {
    "caries": os.getenv("CARIES_API_KEY", os.getenv("MODEL_OCCLUSAL_KEY", os.getenv("MODEL_API_KEY", ""))),
    "tooth": os.getenv("TOOTH_API_KEY", os.getenv("MODEL_TOOTH_KEY", os.getenv("MODEL_API_KEY", ""))),
    "gingivitis": os.getenv("GINGIVITIS_API_KEY", os.getenv("MODEL_GINGIVITIS_KEY", os.getenv("MODEL_API_KEY", ""))),
}
