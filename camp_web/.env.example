# Copy to server/.env. Never commit that file.
APP_ENV=development
PORT=8080
DATABASE_NAME=dentalx_camp
MONGODB_URI=mongodb://127.0.0.1:27017/dentalx_camp
JWT_SECRET=replace-with-at-least-32-random-characters

# Model APIs (all are independent FastAPI services)
CARIES_API_URL=http://127.0.0.1:8001/analyze
TOOTH_API_URL=http://127.0.0.1:8002/analyze
GINGIVITIS_API_URL=http://127.0.0.1:8003/analyze
MODEL_TIMEOUT_SECONDS=90
MODEL_API_KEY=

CAMP_NAME=DentalX Community Dental Camp

# Optional report email. If omitted, PDF download still works.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
